# set up these configs in environment of your working directory

PI_WORKFLOW_MODEL=anthropic/claude-opus-4-8 # global fallback for all agents

# ── Skills ────────────────────────────────────────────────────────────────────

# linear skill (skills/linear): Personal API key for the Linear GraphQL API.
# Create one at Linear → Settings → API → Personal API keys (starts with lin_api_).
# For an OAuth token instead, set: LINEAR_API_KEY="Bearer <access_token>"
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx

# atlassian skill (skills/atlassian): Jira Cloud REST API (HTTP Basic with a token).
# ATLASSIAN_SITE accepts `mycompany`, `mycompany.atlassian.net`, or a full URL.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE=mycompany
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=xxxxxxxxxxxxxxxx

# lsp skill (skills/lsp): no key needed — install the language servers you use
# (see skills/lsp/SKILL.md). Optionally override the server per extension, e.g.:
# LSP_SERVER_PY="pylsp"          # use python-lsp-server instead of pyright
# LSP_SERVER_TS="vtsls --stdio"  # alternate TypeScript server

# Per-agent model (agent-workflow). Set one var per agent — just the model name:
# PI_AGENT_<NAME>_MODEL, where <NAME> is the agent uppercased with hyphens as
# underscores (SCOUT, PLANNER, REFINER, IMPLEMENTER, REVIEWER, VALIDATOR, SHIPPER,
# and specialists like SEEKER, ATLASSIAN, LINEAR). Omit one to inherit
# PI_WORKFLOW_MODEL (or the primary session's model).
#
# The context window (the dashboard usage-bar denominator) is read AUTOMATICALLY
# from pi's model registry (models.json) by model — you do NOT set it here. If a
# model lacks a contextWindow in models.json, add it there (the right place), e.g.
#   { "id": "gateframe/gpt-5-nano", "name": "GPT-5 Nano", "contextWindow": 400000 }
# (As an override you can still use the object form
# PI_AGENT_<NAME>={"model":"…","contextWindow":…}, but it's no longer needed.)
#
# Resolution for model: /agent-model (session) > PI_AGENT_<NAME>_MODEL >
# the agent's .md `model:` > PI_WORKFLOW_MODEL > the primary session's model.
# Pipeline order: scout -> planner -> refiner -> implementer -> reviewer -> validator -> shipper.
PI_AGENT_SCOUT_MODEL=anthropic/claude-haiku-4-5
PI_AGENT_PLANNER_MODEL=anthropic/claude-opus-4-8
PI_AGENT_REFINER_MODEL=anthropic/claude-sonnet-4-6
PI_AGENT_IMPLEMENTER_MODEL=anthropic/claude-sonnet-4-6
PI_AGENT_REVIEWER_MODEL=anthropic/claude-opus-4-8
PI_AGENT_VALIDATOR_MODEL=anthropic/claude-opus-4-8
PI_AGENT_SHIPPER_MODEL=anthropic/claude-haiku-4-5

# ── Runtime behavior ──────────────────────────────────────────────────────────

# Desktop notifications (OSC 9): ping the terminal when a workflow/dispatch finishes
# and when the ask_user tool is waiting for input. On by default; set to 0 to disable.
# Needs a terminal that supports OSC 9 (iTerm2, kitty, WezTerm, Ghostty, …).
PI_NOTIFY=1

# Session file TTL in days (default: 7, minimum: 1). Session files older than
# this are cleaned up on workflow start. Set higher if you want to resume older
# sessions; lower to reclaim disk sooner.
PI_WORKFLOW_SESSION_TTL_DAYS=7

# Directory where agent session files are stored (default: ~/.pi/agent/sessions).
# Supports ~ expansion. Session files are cleaned up based on PI_WORKFLOW_SESSION_TTL_DAYS.
PI_WORKFLOW_SESSION_DIR=~/.pi/agent/sessions

# Per-agent watchdog timeout in minutes (default: 0 = no timeout). An agent that
# runs longer than this is killed and reported as timed out. Set to e.g. 10 or
# 15 to prevent runaway agents from blocking the pipeline indefinitely.
PI_WORKFLOW_AGENT_TIMEOUT=0

# Transient-error retries: when an agent spawn fails with a TRANSIENT error — an
# interrupted/incomplete stream (e.g. "Stream ended without finish_reason"), a
# dropped connection, or a 429/502/503/504/529 — the SAME model is retried this many
# times with linear backoff before the phase fails. Default 2 (clamped 0..5).
# Model-config failures (fall back to another model) and logical failures (bad
# output, test fail) and the watchdog timeout are NOT retried.
PI_AGENT_TRANSIENT_RETRIES=2
# Base backoff between those retries in ms; the Nth retry waits base*N (default 1000).
PI_AGENT_TRANSIENT_BACKOFF_MS=1000

# Maximum dispatch_agent calls per primary-agent turn (default: 20). Prevents
# infinite dispatch loops if the orchestrator keeps delegating. Raise if your
# workflow legitimately needs more; lower if you want tighter guardrails.
PI_MAX_DISPATCHES_PER_TURN=20

# How deep dispatch may nest (code default: 1 = single level — only the top agent
# dispatches; sub-agents that try to dispatch are refused). The bundled agents are
# all single-level — the orchestrator dispatches leaf specialists (`seeker`, `linear`,
# `atlassian`, `scout`, …) and none of them dispatch further — so the default of 1 is
# sufficient. Raise to 2+ only if you add an agent that itself dispatches. A cycle
# guard (an agent dispatching one already in its chain) is always on, independent of
# this. Sub-agents are separate processes; depth + the dispatch chain propagate via
# PI_DISPATCH_DEPTH / PI_DISPATCH_ANCESTRY, which are set automatically per spawn —
# do not set those by hand.
PI_DISPATCH_MAX_DEPTH=1

# Confine sub-agents' FILE tools (read/edit/write/grep/find/ls) to the working
# directory: set to 1 to load extensions/cwd-guard.ts into every spawned agent,
# which blocks any file path that escapes the cwd (absolute paths elsewhere, ../
# traversal). Off by default. Read-only tools (read/grep/find/ls) may ALSO reach
# the skill directories outside the cwd — the bundled skills/ AND pi's global
# skills (getAgentDir()/skills, i.e. $PI_CODING_AGENT_DIR or ~/.pi/agent, plus
# ~/.pi/skills) — so skill-using agents like seeker can read their own skill files;
# write tools stay confined to the cwd.
# NOTE: `bash` is NOT confined — a shell command can still read/write anywhere; the
# agent prompts instruct staying in the cwd as a soft backstop, but true bash
# confinement needs OS-level sandboxing.
PI_CONFINE_CWD=1

# ── Cross-agent context sharing ──────────────────────────────────────────────

# agent-workflow: enable the curated cross-agent context bundle (on by default).
# Each later phase receives a "Shared run context" block containing durable
# artifacts earlier agents produced (recon, critique, etc.) that the task
# builders do not already thread. Set to 0 to disable — each agent then sees
# only what its own task prompt carries.
PI_AGENT_WORKFLOW_SHARED_CONTEXT=1

# ── Project trust (sub-agents) ───────────────────────────────────────────────

# pi >= 0.79 gates project-local inputs behind "project trust". Interactive pi
# asks once and saves your choice to ~/.pi/agent/trust.json. But our sub-agents
# run headless (--mode json -p), and headless pi shows NO prompt — without a
# SAVED trust decision it SILENTLY ignores the repo's project-local inputs
# (AGENTS.md / CLAUDE.md conventions, .pi/settings.json, .pi skills/resources).
# The sub-agents would stop following your
# repo conventions and nothing would warn you.
#
# Recommended: run `/trust` once in your project (interactive pi). The workflow
# then auto-detects that saved decision and passes --approve to each spawn, so
# sub-agents load the same project-local inputs the primary session does. Decline
# (a saved `false`) is respected — spawns are NOT approved.
#
# Override the auto-detection with this var:
#   1 = always pass --approve to spawns (use when you trusted the project for
#       THIS session only, which is not saved to trust.json).
#   0 = never pass --approve, even if trust.json marks the project trusted.
# Unset = auto: approve iff trust.json has `true` for this directory.
# PI_WORKFLOW_APPROVE_PROJECT=1

# ── Plan archiving ───────────────────────────────────────────────────────────

# Save each run's final (refined) plan to docs/plans/<YYYY-MM-DD>-<slug>.md as a
# permanent, reviewable record (and context for future runs — the planner reads
# docs/plans/). Written for EVERY attempt that ran implementation — passed OR
# failed — with the outcome stamped at the top and the file name uniquified so a
# retry never overwrites an earlier attempt's record. Works whether or not a
# shipper runs, so projects without git/versioning still track their work; when a
# shipper runs on success it commits the file with the change. The active
# .agent/plan.md stays per-run; this never makes a plan cumulative. Off by default;
# also auto-enabled whenever a docs/plans/ directory already exists. Set to 1 to
# force on.
PI_WORKFLOW_ARCHIVE_PLANS=0

# ── Observability — AI run summaries (optional) ──────────────────────────────

# The obs dashboard's "Explain" button summarizes a run on top of the
# deterministic digest (GET /api/runs/:id/explain). It runs the `pi` CLI with the
# model below, so it reuses pi's provider auth — no separate API key. OFF by
# default; the dashboard and digest work fully without it. Uncomment to enable.
# PI_OBS_LLM=1
# PI_OBS_LLM_MODEL=...   # any pi model id; leave unset to inherit the primary agent's
#                          own model (PI_WORKFLOW_MODEL, else the live session model)
# PI_OBS_LLM_TIMEOUT_MS=60000

# The obs-server auto-scores runs that ended without a verdict (heuristic, from
# the run's digest; source "auto", overridable). On by default; set to 0 to stop it.
# PI_OBS_AUTO_VERDICT=0

# ── Observability — API auth (optional) ──────────────────────────────────────

# Shared secret for the obs dashboard/API. Unset = open (the loopback default).
# When set, every data + control route requires the token via
# `Authorization: Bearer <token>` (or `?token=` for the SSE/EventSource streams);
# the static dashboard shell prompts for it and caches it in localStorage. The
# control routes can steer a live agent, so set this whenever the server is
# reachable beyond your own loopback (e.g. exposed via Tailscale / a proxy).
# Generate one with: openssl rand -hex 32
# PI_OBS_TOKEN=

# Interface the obs-server binds. Defaults to 127.0.0.1 (loopback only). Set to
# 0.0.0.0 to listen on all interfaces — required when running in a container so a
# published port can reach it. Only bind beyond loopback together with
# PI_OBS_TOKEN (and a firewall/proxy); the server prints a warning otherwise.
# PI_OBS_HOST=0.0.0.0

# ── Observability — Telegram bridge (optional) ───────────────────────────────

# Talk to your agent observability from Telegram: `./run.sh --bridge` (which
# cold-starts the obs-server too if none is running; `npm run obs:bridge` expects
# one already up). It long-polls Telegram (no inbound webhook — the
# obs-server stays on loopback) and maps messages onto the obs API: free text
# chats with the assistant (needs PI_OBS_LLM=1 on the server); /runs, /last,
# /digest, /search, /live, /pass, /fail score and inspect runs; and /steer drives
# the live orchestrator (injects into the running agent — allowlist is the gate).
#
# Bot token from @BotFather. Required — without it the bridge does not start.
# PI_OBS_TG_TOKEN=123456:ABC-your-bot-token
# Comma/space-separated Telegram chat ids allowed to use the bridge. Fail closed:
# empty = every message refused. Message the bot once and it replies with your id.
# PI_OBS_TG_ALLOW=
# Optional: let the chat assistant use tools (default off — text-only, no side
# effects). Steering a live agent is a separate, deliberate surface.
# PI_OBS_TG_TOOLS=0
# Optional overrides:
# PI_OBS_TG_MODEL=...        # model for the chat assistant (else the server default)
# PI_OBS_TG_CWD=...          # project dir to scope chat sessions to
# PI_OBS_TG_POLL_S=50        # Telegram long-poll timeout (seconds)
# PI_OBS_TG_EDIT_MS=1200     # min gap between live message edits while streaming
# PI_OBS_BRIDGE_API=http://127.0.0.1:7616   # obs-server base (else PI_OBS_HOST:PORT)
# Set PI_OBS_TOKEN above too if the server requires auth — the bridge sends it.
