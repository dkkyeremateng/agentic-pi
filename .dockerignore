# The image runs only the obs server (obs/ + utils/ + tsx). Keep everything else
# out so the build context stays small and the React app is never bundled.
.git
node_modules
**/node_modules

# The dashboard is BUILT in the image (see the ui-build stage), so obs/ui's
# sources must stay in the context. Only the local build output is excluded — the
# image makes its own, and a stale host dist/ must never shadow it.
obs/ui/dist
mockups

# Local scratch / runtime artifacts.
.agent
*.log
.obs-server.log
.env
.DS_Store

# Not needed to run the server.
themes
prompts
agents
skills
install.sh
run.sh
AGENTS.md
README.md
DOCKER.md
test-results
playwright-report
