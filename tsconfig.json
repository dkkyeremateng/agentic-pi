{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2023"],
        "types": ["node"],
        "strict": true,
        "noImplicitAny": false,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
    },
    "include": ["utils/**/*.ts", "extensions/**/*.ts", "obs/**/*.ts"],
    // obs/ui is the dashboard: browser code (DOM lib, JSX, bundler resolution)
    // with its own tsconfig and its own `npm run typecheck`. This config targets
    // Node and would report its window/DOM references as errors, so keep the two
    // type-check passes separate.
    "exclude": ["obs/ui"],
}
