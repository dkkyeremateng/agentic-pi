{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2023"],
        "types": ["node"],
        "strict": true,
        "noImplicitAny": false,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
    },
    "include": ["utils/**/*.ts", "extensions/**/*.ts", "obs/**/*.ts"],
}
