{
  "name": "pi-config",
  "private": true,
  "description": "pi extensions + agent definitions (workflow orchestrators)",
  "workspaces": [
    "obs/ui"
  ],
  "scripts": {
    "setup:types": "bash scripts/link-pi-types.sh",
    "pretypecheck": "bash scripts/link-pi-types.sh",
    "typecheck": "tsc --noEmit",
    "pretest": "bash scripts/link-pi-types.sh",
    "test": "tsx --test utils/*/*.test.ts obs/*.test.ts",
    "metrics": "tsx obs/obs-cli.ts",
    "obs:server": "tsx obs/obs-server.ts",
    "obs:bridge": "tsx obs/obs-bridge.ts",
    "obs:export": "tsx obs/obs-export.ts",
    "test:linear": "python3 -m unittest discover -s skills/linear -p 'test_*.py'",
    "test:atlassian": "python3 -m unittest discover -s skills/atlassian -p 'test_*.py'",
    "patch:prune": "bash scripts/patch-context-prune.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
