# Single ignore file for the whole repo, including the obs dashboard (obs/ui),
# which had its own before being vendored in. Patterns without a slash match at
# any depth, so the generic rules below cover obs/ui too.

# ── secrets / machine-specific config ────────────────────────────────────────
# Config for every package lives in the repo-root .env (obs/ui reads it via
# Vite's envDir). example.env is the committed reference and matches neither rule.
.env
.env.*

# ── dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── build output ─────────────────────────────────────────────────────────────
# A top-level build dir only. The leading slash ANCHORS this to the repo root —
# it does not match obs/ui/dist (or any other nested dist/).
/dist

# NOTE: obs/ui/dist is deliberately NOT ignored — it is committed on purpose.
# obs-server serves the dashboard straight from it, so a fresh clone and the
# Docker image get a working UI with no bundler step. Do NOT drop the leading
# slash above: a blanket `dist/` would match obs/ui/dist, and while that can't
# untrack the files already committed, it would make `git add` silently skip the
# NEW hashed asset a rebuild emits — shipping a stale dashboard.
# Rebuild and commit it after changing obs/ui/src: cd obs/ui && npm run build

# ── caches ───────────────────────────────────────────────────────────────────
*.tsbuildinfo
.vite/
__pycache__/
*.pyc

# ── runtime state / logs ─────────────────────────────────────────────────────
.agent/
.pi/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.obs-bridge.pid

# ── tooling ──────────────────────────────────────────────────────────────────
.claude/
.playwright-mcp/
.playwright-cli/
.playwright/

# ── editors ──────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
*/DS_Store
Thumbs.db

# ── project-specific ─────────────────────────────────────────────────────────
extensions/qa-review.ts
mockups/
/docs/
obs/ui/ds/
